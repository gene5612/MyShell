{
  "name": "myshell",
  "productName": "MyShell",
  "version": "1.0.0",
  "description": "A Xshell-like SSH & local terminal tool built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.myshell.terminal",
    "productName": "MyShell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "compression": "store",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MyShell-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyShell",
      "artifactName": "MyShell-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "ssh2": "^1.16.0"
  }
}
